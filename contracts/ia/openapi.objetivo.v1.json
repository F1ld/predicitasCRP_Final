{
  "openapi": "3.1.0",
  "info": {"title": "PrediCitas IA — contrato OBJETIVO, servicio aun no implementado", "version": "1.0.0", "description": "Solo backend autorizado. Sin PostgreSQL, JWT de negocio, entrenamiento HTTP ni mutaciones de citas. Perfil de extraccion del modelo actual."},
  "servers": [{"url": "http://ia:8100", "description": "Direccion interna Docker futura, no URL para navegador"}],
  "security": [{"IAApiKey": []}],
  "paths": {
    "/health/live": {"get": {"operationId": "live", "security": [], "responses": {"200": {"description": "Proceso vivo", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["estado"], "properties": {"estado": {"const": "vivo"}}}}}}}}},
    "/health/ready": {"get": {"operationId": "ready", "security": [], "responses": {"200": {"description": "Artefacto aprobado compatible cargado", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["estado"], "properties": {"estado": {"const": "listo"}}}}}}, "503": {"$ref": "#/components/responses/ModelUnavailable"}}}},
    "/v1/model": {"get": {"operationId": "modelMetadata", "responses": {"200": {"description": "Metadata activa sin filas de datos", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModelMetadata"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/ModelUnavailable"}, "500": {"$ref": "#/components/responses/InternalError"}}}},
    "/v1/metrics": {"get": {"operationId": "modelMetrics", "responses": {"200": {"description": "Metadatos del artefacto que permiten conservar DTO publico; no lee BD", "content": {"application/json": {"schema": {"$ref": "../backend/openapi.actual.v0.5.0.json#/components/schemas/MetricasModeloOut"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/ModelUnavailable"}, "500": {"$ref": "#/components/responses/InternalError"}}}},
    "/v1/dataset": {"get": {"operationId": "datasetMetadata", "responses": {"200": {"description": "Manifiesto TRAINING_RUN o LEGACY_IMPORT explicito con linaje incompleto; no filas ni conteos operativos de BD", "content": {"application/json": {"schema": {"$ref": "../data/dataset-manifest.v1.schema.json"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/ModelUnavailable"}, "500": {"$ref": "#/components/responses/InternalError"}}}},
    "/v1/predict": {"post": {"operationId": "predict", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "predict-request.v1.schema.json"}}}}, "responses": {"200": {"description": "Inferencia sin persistencia; probabilidad numerica redondeada a 3 decimales", "content": {"application/json": {"schema": {"$ref": "predict-response.v1.schema.json"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "409": {"$ref": "#/components/responses/VersionMismatch"}, "413": {"$ref": "#/components/responses/TooLarge"}, "422": {"$ref": "#/components/responses/InvalidInput"}, "503": {"$ref": "#/components/responses/ModelUnavailable"}, "500": {"$ref": "#/components/responses/InternalError"}}}},
    "/v1/predict-batch": {"post": {"operationId": "predictBatch", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "batch-request.v1.schema.json"}}}}, "responses": {"200": {"description": "1..100 items de la misma version; todo el lote es valido o error", "content": {"application/json": {"schema": {"$ref": "batch-response.v1.schema.json"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "409": {"$ref": "#/components/responses/VersionMismatch"}, "413": {"$ref": "#/components/responses/TooLarge"}, "422": {"$ref": "#/components/responses/InvalidInput"}, "503": {"$ref": "#/components/responses/ModelUnavailable"}, "500": {"$ref": "#/components/responses/InternalError"}}}}
  },
  "components": {
    "securitySchemes": {"IAApiKey": {"type": "apiKey", "in": "header", "name": "X-IA-API-Key"}},
    "schemas": {
      "ModelMetadata": {"type": "object", "additionalProperties": false, "required": ["version_contrato", "version_modelo", "version_features", "version_dataset", "umbrales", "features_autorizadas", "es_simulacion", "rotulo_etico"], "properties": {"version_contrato": {"const": "1.0"}, "version_modelo": {"type": "string", "minLength": 1, "maxLength": 100}, "version_features": {"const": "pre-cita-v1"}, "version_dataset": {"type": "string", "minLength": 1, "maxLength": 100}, "umbrales": {"type": "object", "additionalProperties": false, "required": ["medio", "alto"], "properties": {"medio": {"const": 0.3}, "alto": {"const": 0.45}}}, "features_autorizadas": {"type": "array", "uniqueItems": true, "minItems": 9, "maxItems": 9, "items": {"enum": ["especialidad", "tipo_paciente", "canal_origen", "franja_horaria", "dia_semana", "antelacion_dias", "inasistencias_previas", "asistencias_previas", "reprogramaciones_prev"]}}, "es_simulacion": {"const": true}, "rotulo_etico": {"const": "Resultado simulado — Dataset sintético acreditado (RF-056)"}}}
    },
    "responses": {
      "Unauthorized": {"description": "Clave interna ausente o invalida: NO_AUTENTICADO", "content": {"application/json": {"schema": {"$ref": "error.v1.schema.json"}}}},
      "VersionMismatch": {"description": "Modelo solicitado distinto del activo: VERSION_MODELO_INCOMPATIBLE", "content": {"application/json": {"schema": {"$ref": "error.v1.schema.json"}}}},
      "TooLarge": {"description": "Body mayor a 256 KiB: SOLICITUD_DEMASIADO_GRANDE", "content": {"application/json": {"schema": {"$ref": "error.v1.schema.json"}}}},
      "InvalidInput": {"description": "JSON/features/lote invalidos: VALIDACION", "content": {"application/json": {"schema": {"$ref": "error.v1.schema.json"}}}},
      "ModelUnavailable": {"description": "Sin artefacto compatible listo: MODELO_NO_DISPONIBLE", "content": {"application/json": {"schema": {"$ref": "error.v1.schema.json"}}}},
      "InternalError": {"description": "Fallo inesperado sin datos internos: ERROR_INTERNO", "content": {"application/json": {"schema": {"$ref": "error.v1.schema.json"}}}}
    }
  }
}
