{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predicitas.invalid/contracts/data/cita-import-normalizada.v1.schema.json",
  "title": "Fila operacional despues de normalizar tipos, mayusculas y zona; no CSV crudo",
  "type": "object",
  "additionalProperties": true,
  "required": ["id_cita_externa", "paciente_anon_id", "sede", "especialidad", "medico", "fecha_hora_cita", "fecha_registro_cita", "tipo_paciente", "canal_origen"],
  "properties": {
    "id_cita_externa": {"type": "string", "minLength": 1, "maxLength": 50},
    "paciente_anon_id": {"type": "string", "minLength": 1, "maxLength": 50},
    "sede": {"const": "SAN_ISIDRO"},
    "especialidad": {"enum": ["CARDIOLOGIA", "TRAUMATOLOGIA", "PEDIATRIA"]},
    "medico": {"type": "string", "minLength": 1, "maxLength": 100},
    "fecha_hora_cita": {"type": "string", "format": "date-time"},
    "fecha_registro_cita": {"type": "string", "format": "date-time"},
    "tipo_paciente": {"enum": ["NUEVO", "CONTINUADOR"]},
    "canal_origen": {"enum": ["WEB", "CALL_CENTER", "PRESENCIAL"]},
    "inasistencias_previas": {"type": ["integer", "null"], "minimum": 0, "default": null},
    "asistencias_previas": {"type": ["integer", "null"], "minimum": 0, "default": null},
    "reprogramaciones_prev": {"type": "integer", "minimum": 0, "default": 0},
    "estado_actual": {"enum": ["RECIBIDA", "CONFIRMADA", "REPROGRAMADA", "CANCELADA", "ATENDIDA", "NO_SHOW"], "default": "RECIBIDA"}
  }
}
