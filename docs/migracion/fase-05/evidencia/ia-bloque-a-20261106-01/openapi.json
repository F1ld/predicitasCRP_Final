  "components": {
    "schemas": {
      "BatchItemRequest": {
        "properties": {
          "id_item": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Id Item"
          },
          "features": {
            "$ref": "#/components/schemas/FeaturesPreCita"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id_item",
          "features"
        ],
        "title": "BatchItemRequest",
        "description": "Elemento individual de un lote de inferencia."
      },
      "BatchItemResponse": {
        "properties": {
          "id_item": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Id Item"
          },
          "resultado": {
            "$ref": "#/components/schemas/PredictResponse"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id_item",
          "resultado"
        ],
        "title": "BatchItemResponse",
        "description": "Resultado individual de un ítem dentro de la respuesta en lote."
      },
      "BatchRequest": {
        "properties": {
          "version_contrato": {
            "type": "string",
            "const": "1.0",
            "title": "Version Contrato"
          },
          "id_solicitud": {
            "type": "string",
            "format": "uuid",
            "title": "Id Solicitud"
          },
          "version_modelo": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Version Modelo"
          },
          "version_features": {
            "type": "string",
            "const": "pre-cita-v1",
            "title": "Version Features"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BatchItemRequest"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version_contrato",
          "id_solicitud",
          "version_modelo",
          "version_features",
          "items"
        ],
        "title": "BatchRequest",
        "description": "Solicitud de inferencia en lote (1..100 elementos)."
      },
      "BatchResponse": {
        "properties": {
          "version_contrato": {
            "type": "string",
            "const": "1.0",
            "title": "Version Contrato",
            "default": "1.0"
          },
          "id_solicitud": {
            "type": "string",
            "format": "uuid",
            "title": "Id Solicitud"
          },
          "version_modelo": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Version Modelo"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BatchItemResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id_solicitud",
          "version_modelo",
          "items"
        ],
        "title": "BatchResponse",
        "description": "Respuesta completa de inferencia en lote."
      },
      "BloqueMetricas": {
        "properties": {
          "umbral": {
            "type": "number",
            "title": "Umbral"
          },
          "f1_score": {
            "type": "number",
            "title": "F1 Score"
          },
          "precision": {
            "type": "number",
            "title": "Precision"
          },
          "recall": {
            "type": "number",
            "title": "Recall"
          },
          "roc_auc": {
            "type": "number",
            "title": "Roc Auc"
          },
          "pr_auc": {
            "type": "number",
            "title": "Pr Auc"
          },
          "matriz_confusion": {
            "$ref": "#/components/schemas/MatrizConfusion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "umbral",
          "f1_score",
          "precision",
          "recall",
          "roc_auc",
          "pr_auc",
          "matriz_confusion"
        ],
        "title": "BloqueMetricas"
      },
      "ControlLeakage": {
        "properties": {
          "aprobado": {
            "type": "boolean",
            "const": true,
            "title": "Aprobado"
          },
          "columnas_prohibidas_excluidas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 8,
            "title": "Columnas Prohibidas Excluidas"
          },
          "interseccion_particiones": {
            "type": "integer",
            "const": 0,
            "title": "Interseccion Particiones"
          },
          "violaciones_temporales": {
            "type": "integer",
            "const": 0,
            "title": "Violaciones Temporales"
          },
          "invariante_paciente_nuevo_ok": {
            "type": "boolean",
            "const": true,
            "title": "Invariante Paciente Nuevo Ok"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "aprobado",
          "columnas_prohibidas_excluidas",
          "interseccion_particiones",
          "violaciones_temporales",
          "invariante_paciente_nuevo_ok"
        ],
        "title": "ControlLeakage"
      },
      "DatasetLegacy": {
        "properties": {
          "version_contrato": {
            "type": "string",
            "const": "1.0",
            "title": "Version Contrato"
          },
          "version_dataset": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Version Dataset"
          },
          "version_features": {
            "type": "string",
            "const": "pre-cita-v1",
            "title": "Version Features"
          },
          "proposito": {
            "type": "string",
            "const": "LEGACY_IMPORT",
            "title": "Proposito"
          },
          "fuente": {
            "type": "string",
            "const": "LEGACY_METADATA_ONLY",
            "title": "Fuente"
          },
          "linaje_completo": {
            "type": "boolean",
            "const": false,
            "title": "Linaje Completo"
          },
          "semilla": {
            "type": "integer",
            "const": 42,
            "title": "Semilla"
          },
          "fecha_corte": {
            "type": "null",
            "title": "Fecha Corte"
          },
          "generado_en": {
            "type": "string",
            "format": "date-time",
            "title": "Generado En"
          },
          "sha256_raw": {
            "type": "null",
            "title": "Sha256 Raw"
          },
          "total_historicas": {
            "type": "integer",
            "minimum": 1000.0,
            "title": "Total Historicas"
          },
          "distribucion": {
            "$ref": "#/components/schemas/Distribucion"
          },
          "particiones": {
            "$ref": "#/components/schemas/ParticionesLegacy"
          },
          "sin_interseccion_ids": {
            "type": "boolean",
            "const": true,
            "title": "Sin Interseccion Ids"
          },
          "control_leakage": {
            "$ref": "#/components/schemas/ControlLeakage"
          },
          "es_simulacion": {
            "type": "boolean",
            "const": true,
            "title": "Es Simulacion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version_contrato",
          "version_dataset",
          "version_features",
          "proposito",
          "fuente",
          "linaje_completo",
          "semilla",
          "fecha_corte",
          "generado_en",
          "sha256_raw",
          "total_historicas",
          "distribucion",
          "particiones",
          "sin_interseccion_ids",
          "control_leakage",
          "es_simulacion"
        ],
        "title": "DatasetLegacy"
      },
      "Distribucion": {
        "properties": {
          "atendidas": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Atendidas"
          },
          "no_show": {
            "type": "integer",
            "minimum": 1.0,
            "title": "No Show"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "atendidas",
          "no_show"
        ],
        "title": "Distribucion"
      },
      "ErrorDetail": {
        "properties": {
          "codigo": {
            "type": "string",
            "enum": [
              "NO_AUTENTICADO",
              "VALIDACION",
              "MODELO_NO_DISPONIBLE",
              "VERSION_MODELO_INCOMPATIBLE",
              "ERROR_INTERNO",
              "SOLICITUD_DEMASIADO_GRANDE"
            ],
            "title": "Codigo"
          },
          "mensaje": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Mensaje"
          },
          "campos": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Campos"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "codigo",
          "mensaje"
        ],
        "title": "ErrorDetail",
        "description": "Detalle del error en conformidad con error.v1.schema.json."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "Cuerpo de respuesta para errores HTTP del servicio IA."
      },
      "FeaturesPreCita": {
        "properties": {
          "especialidad": {
            "type": "string",
            "enum": [
              "CARDIOLOGIA",
              "TRAUMATOLOGIA",
              "PEDIATRIA"
            ],
            "title": "Especialidad"
          },
