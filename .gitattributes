# Git attributes for PrediCitas CRP monorepo
# Enforce LF for shell scripts (used inside Linux containers)
*.sh text eol=lf

# Mark binary files
*.joblib binary
*.pkl binary
*.pickle binary
*.dump binary
*.zip binary
*.tar binary
*.jpg binary
*.png binary
*.csv text eol=crlf

# Lock files are generated
package-lock.json -diff

# Evidence hashes must survive Windows/Linux checkouts byte for byte.
/docs/migracion/fase-03/evidencia/** text eol=lf
