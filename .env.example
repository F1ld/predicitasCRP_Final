# PrediCitas CRP · Configuración Central de Entorno para Docker Compose
POSTGRES_USER=predicitas_owner
POSTGRES_PASSWORD=predicitas_owner_dev
POSTGRES_DB=predicitas
APP_DB_USER=predicitas_app
APP_DB_PASSWORD=predicitas_app_dev
DB_PUERTO_HOST=5432
# Volumen existente aprobado; no se crea automáticamente ni se siembra.
PGDATA_VOLUME_NAME=predicitas-crp_pgdata
# POSTGRES_USER/DB y APP_DB_USER son nombres fijos en compose.yaml.
# Las contraseñas deben coincidir con los roles del volumen existente.
# SEED_PASSWORD solo se usa en el perfil explícito seed-manual; no ejecutar en Existing.

SECRET_KEY=solo-desarrollo-local-cambiar-esta-clave-0123456789
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
